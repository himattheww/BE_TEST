{
  "name": "items-api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for processing project line items with exact decimal calculation, backed by Supabase",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.109.0",
    "decimal.js": "^10.6.0",
    "express": "^5.2.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "tinypool": "^2.2.0"
  }
}
