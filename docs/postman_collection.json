        "body": {
          "mode": "raw",
          "raw": "{\n  \"event\": \"line_items.created\",\n  \"eventId\": \"evt_20261009_001\",\n  \"data\": {\n    \"projectId\": \"{{projectId}}\",\n    \"lineItems\": [\n      {\n        \"itemCode\": \"A-001\",\n        \"itemDescription\": \"Excavation\",\n        \"qty\": \"-5\",\n        \"price\": \"10.00\"\n      }\n    ]\n  }\n}",
          "options": {
