            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/webhook/ingest",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "webhook",
            "ingest"
          ]
        }
      }
    },
    {
      "name": "Webhook ingest - without credentials",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event\": \"line_items.created\",\n  \"eventId\": \"evt_20261009_001\",\n  \"data\": {\n    \"projectId\": \"{{projectId}}\",\n    \"lineItems\": [\n      {\n        \"itemCode\": \"a-001\",\n        \"itemDescription\": \"Excavation\",\n        \"qty\": \"12.50\",\n        \"uom\": \"m3\",\n        \"price\": \"150000.00\"\n      },\n      {\n        \"itemCode\": \"B-002\",\n        \"itemDescription\": \"Formwork\",\n        \"qty\": 0.1,\n        \"price\": \"0.20\"\n      }\n    ]\n  }\n}",
          "options": {
